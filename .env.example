# Meta Ads MCP Server — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Long-lived System User access token from Business Manager.
# Scopes required: ads_management, ads_read, business_management,
#                  pages_read_engagement (for posting on behalf of a Page).
META_ACCESS_TOKEN=

# Ad Account ID, including the "act_" prefix. You can find this in the URL
# of Ads Manager (act=...). Example: act_47599739
META_AD_ACCOUNT_ID=act_47599739

# Facebook Page ID that owns the ads. Find via Page Settings → Page info,
# or by calling GET /me/accounts with a User Access Token that has
# pages_show_list permission.
META_PAGE_ID=

# Graph API version. Bump as Meta releases new versions.
META_GRAPH_API_VERSION=v21.0
